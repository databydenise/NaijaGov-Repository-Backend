# Copy to .env and fill in. Never commit .env — it is gitignored.

# The Postgres database. Used by the app, by Alembic, and by the seed/cleanup commands.
# asyncpg rejects libpq-only query parameters, so no ?sslmode= or ?pgbouncer= here.
#
# Local example (Postgres.app, database created with `createdb naijagov_dev`):
#   postgresql://your-macos-user@localhost:5432/naijagov_dev
DATABASE_URL=postgresql://user:password@localhost:5432/naijagov_dev

# SQL statement logging. Local development only — it prints query text.
DB_ECHO=false

# How long a chat/fill session lives before its row is treated as expired.
SESSION_TTL_HOURS=24

# --- Deployment ---
# development | staging | production
ENV=development

# Exact origins for CORS, never "*". The extension origin looks like
# chrome-extension://<id> and can be left blank until the extension is loaded.
WEB_ORIGIN=http://localhost:3000
EXTENSION_ORIGIN=

# --- Web session ---
# At least 32 bytes or the app refuses to boot. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-text
SESSION_TTL_DAYS=7

# --- Extension tokens ---
TOKEN_TTL_DAYS=30

# --- Demo account ---
# Refuses to boot if DEMO_MODE=true while ENV=production.
DEMO_MODE=false
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-account-not-for-real-use

# The demo account's extension token, installed when the server starts. Fixed here rather
# than generated, so it survives the restarts `fastapi dev` does on every file save. Must be
# ngv_ plus at least 32 random characters. Generate one with:
#   python -c "import secrets; print('ngv_' + secrets.token_urlsafe(32))"
# Leave blank to have the demo account without a pre-issued token.
DEMO_TOKEN=
